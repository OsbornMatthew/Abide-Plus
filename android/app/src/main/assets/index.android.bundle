\u0bc1 6:6-19',focusVerseEn:'1 Timothy 6:6',focusVerseTa:'1 \u0ba4\u0bc0\u0bae\u0bcb\u0ba4\u0bcd\u0ba4\u0bc7\u0baf\u0bc1 6:6'},{day:7,passageEn:'Philippians 4:10-20',passageTa:'\u0baa\u0bbf\u0bb2\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0baf\u0bb0\u0bcd 4:10-20',focusVerseEn:'Philippians 4:19',focusVerseTa:'\u0baa\u0bbf\u0bb2\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0baf\u0bb0\u0bcd 4:19'}]}]},563,[]);
