0bb8\u0bcd\u0ba4\u0bc7\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd",category:"\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0bc7\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bae\u0bcd\u0bae\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb1\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bb5\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b89\u0bae\u0b95\u0bcd\u0b95\u0bc1 \u0bb8\u0bcd\u0ba4\u0bc7\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd"},{id:558,number:558,text:"\u0b8e\u0ba9\u0bcd \u0ba4\u0bb2\u0bc8\u0baf\u0bc8 \u0b89\u0baf\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bb1\u0bb5\u0bb0\u0bc7 \u0bb8\u0bcd\u0ba4\u0bc7\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd",category:"\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0bc7\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bae\u0bcd\u0bae\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb1\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bc6\u0bbe\u0ba3\u0bcd\u0b9f\u0bb5\u0bc8\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0b95 \u0b89\u0bae\u0b95\u0bcd\u0b95\u0bc1 \u0bb8\u0bcd\u0ba4\u0bc7\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd"},{id:559,number:559,text:"\u0b8e\u0ba9\u0bcd \u0b95\u0bc6\u0bbe\u0bae\u0bcd\u0baa\u0bc8 \u0b95\u0bbe\u0ba3\u0bcd\u0b9f\u0bbe \u0bae\u0bbf\u0bb0\u0bc1\u0b95\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0b95\u0bc6\u0bbe\u0bae\u0bcd\u0baa\u0bc8\u0baa\u0bcd \u0baa\u0bc7\u0bbe\u0bb2\u0bcd \u0b89\u0baf\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bc0\u0bb0\u0bcd \u0bb8\u0bcd\u0ba4\u0bc7\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bae\u0bcd",category:"\u0b9a\u0ba4\u0bcd\u0ba4\u0bbf\u0baf \u0bb5\u0bc7\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0bae\u0bcd\u0bae\u0bc8\u0b95\u0bcd \u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0ba8\u0bbe\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0bb1\u0bbf\u0ba8\u0bcd\u0ba4\u0bc1 \u0b95\u0bc6