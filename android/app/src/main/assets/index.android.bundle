__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.DAILY_VERSES=void 0;e.DAILY_VERSES=[{id:'vod-1',referenceEn:'Jeremiah 29:11',referenceTa:'\u0b8e\u0bb0\u0bc7\u0bae\u0bbf\u0baf\u0bbe 29:11',textEn:'"For I know the plans I have for you," declares the LORD, "plans to prosper you and not to harm you, plans to give you hope and a future."',textTa:'"\u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0baa\u0bbe\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0b9f\u0bbf\u0bb5\u0bc8 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bbe\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0baa\u0bc7\u0bb0\u0bbf\u0bb2\u0bcd \u0ba8\u0bbf\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1 \u0ba8\u0bbf\u0ba9\u0bc8\u0bb5\u0bc1\u0b95\u0bb3\u0bc8 \u0b85\u0bb1\u0bbf\u0bb5\u0bc7\u0ba9\u0bcd; \u0b85\u0bb5\u0bc8\u0b95\u0bb3\u0bcd \u0ba4\u0bc0\u0bae\u0bc8\u0b95\u0bcd\u0b95\u0bb2\u0bcd\u0bb2, \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bc7\u0ba4\u0bc1\u0bb5\u0bbe\u0ba9 \u0ba8\u0bbf\u0ba9\u0bc8\u0bb5\u0bc1\u0b95\u0bb3\u0bc7 \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0b9a\u0bca\u0bb2\u0bcd\u0bb2\u0bc1\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd."',reflectionEn:'God\u2019s heart toward you is full of good purpose and enduring hope. Even when your path feels uncertain, rest in the promise that His sovereign blueprint for your life is peace, provision, and divine destiny.',reflectionTa:'\u0ba4\u0bc7\u0bb5\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc8\u0b95\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0bb5\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0bae\u0bc1\u0bae\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba8\u0bbf\u0bb1\u0bc8\u0ba8\u0bcd\u0ba4\u0bb5\u0bc8. \u0b9a\u0bc2\u0bb4\u0bcd\u0ba8\u0bbf\u0bb2\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bbe\u0bb1\u0bbf\u0ba9\u0bbe\u0bb2\u0bc1\u0bae\u0bcd, \u0b85\u0bb5\u0bb0\u0bc1\u0b9f\u0bc8\u0baf \u0bae\u0bbe\u0bb1\u0bbe\u0ba4 \u0bb5\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc8 \u0bb5\u0bc8\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',theme:'Hope & Divine Destiny',themeTa:'\u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0bc6\u0baf\u0bcd\u0bb5\u0bc0\u0b95 \u0ba4\u0bbf\u0b9f\u0bcd\u0b9f\u0bae\u0bc1\u0bae\u0bcd',category:'Faith'},{id:'vod-2',referenceEn:'Philippians 4:6-7',referenceTa:'\u0baa\u0bbf\u0bb2\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0baf\u0bb0\u0bcd 4:6-7',textEn:'Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God. And the peace of God, which transcends all understanding, will guard your hearts and your minds in Christ Jesus.',textTa:'\u0ba8\u0bc0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b92\u0ba9\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b99\u0bcd \u0b95\u0bb5\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bbe\u0bae\u0bb2\u0bcd, \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bc1\u0bb1\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbf\u0ba3\u0bcd\u0ba3\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0bb8\u0bcd\u0ba4\u0bcb\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba4\u0bcd\u0ba4\u0bcb\u0b9f\u0bc7 \u0b95\u0bc2\u0b9f\u0bbf\u0baf \u0b9c\u0bc6\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bb2\u0bbf\u0ba9\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0bb5\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0ba4\u0bcd \u0ba4\u0bc6\u0bb0\u0bbf\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd. \u0b85\u0baa\u0bcd\u0baa\u0bca\u0bb4\u0bc1\u0ba4\u0bc1, \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0baa\u0bcd \u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bc7\u0bb2\u0bbe\u0ba9 \u0ba4\u0bc7\u0bb5 \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0ba4\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bbf\u0ba8\u0bcd\u0ba4\u0bc8\u0b95\u0bb3\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b95\u0bbf\u0bb1\u0bbf\u0bb8\u0bcd\u0ba4\u0bc1 \u0b87\u0baf\u0bc7\u0b9a\u0bc1\u0bb5\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0bbe\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bca\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd.',reflectionEn:'Trade your anxiety for prayer and gratitude. When you hand your burdens to God, His supernatural peace becomes an unbreakable shield over your emotions and thoughts today.',reflectionTa:'\u0b95\u0bb5\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bb5\u0ba4\u0bc8 \u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1\u0bb5\u0bbf\u0b9f\u0bcd\u0b9f\u0bc1, \u0bb8\u0bcd\u0ba4\u0bcb\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0ba4\u0bcd\u0ba4\u0bc1\u0b9f\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bc7\u0ba3\u0bcd\u0b9f\u0bc1\u0ba4\u0bb2\u0bc8 \u0ba4\u0bc7\u0bb5\u0ba9\u0bbf\u0b9f\u0bae\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baf\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd. \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bc7\u0bb2\u0bbe\u0ba9 \u0ba4\u0bc7\u0bb5 \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b87\u0bb0\u0bc1\u0ba4\u0baf\u0ba4\u0bcd\u0ba4\u0bc8 \u0b86\u0bb3\u0bc1\u0b95\u0bc8 \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0bc1\u0bae\u0bcd.',theme:'Peace Beyond Measure',themeTa:'\u0b85\u0bb3\u0bb5\u0bb1\u0bcd\u0bb1 \u0ba4\u0bc7\u0bb5 \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0bae\u0bcd',category:'Peace'},{id:'vod-3',referenceEn:'Proverbs 3:5-6',referenceTa:'\u0ba8\u0bc0\u0ba4\u0bbf\u0bae\u0bca\u0bb4\u0bbf\u0b95\u0bb3\u0bcd 3:5-6',textEn:'Trust in the LORD with all your heart and lean not on your own understanding; in all your ways submit to him, and he will make your paths straight.',textTa:'\u0b89\u0ba9\u0bcd \u0b9a\u0bc1\u0baf\u0baa\u0bc1\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd\u0bae\u0bc7\u0bb2\u0bcd \u0b9a\u0bbe\u0baf\u0bbe\u0bae\u0bb2\u0bcd, \u0b89\u0ba9\u0bcd \u0bae\u0bc1\u0bb4\u0bc1 \u0b87\u0bb0\u0bc1\u0ba4\u0baf\u0ba4\u0bcd\u0ba4\u0bcb\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb0\u0bbf\u0bb2\u0bcd \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bbe\u0baf\u0bbf\u0bb0\u0bc1\u0ba8\u0bcd\u0ba4\u0bc1; \u0b89\u0ba9\u0bcd \u0bb5\u0bb4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bc6\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bc8 \u0ba8\u0bbf\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bca\u0bb3\u0bcd; \u0b85\u0baa\u0bcd\u0baa\u0bca\u0bb4\u0bc1\u0ba4\u0bc1 \u0b85\u0bb5\u0bb0\u0bcd \u0b89\u0ba9\u0bcd \u0baa\u0bbe\u0ba4\u0bc8\u0b95\u0bb3\u0bc8\u0b9a\u0bcd \u0b9a\u0bc6\u0bb5\u0bcd\u0bb5\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd.',reflectionEn:'Total surrender brings total guidance. When you invite God into your finances, career, family, and daily decisions, He removes obstacles and aligns your steps in righteousness.',reflectionTa:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc1\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bc8 \u0ba8\u0bae\u0bcd\u0baa\u0bbe\u0bae\u0bb2\u0bcd, \u0bae\u0bc1\u0bb4\u0bc1 \u0b87\u0bb0\u0bc1\u0ba4\u0baf\u0ba4\u0bcd\u0ba4\u0bcb\u0b9f\u0bc1\u0bae\u0bcd \u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb0\u0bc8 \u0ba8\u0bae\u0bcd\u0baa\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd. \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0bb2\u0bcd\u0bb2\u0bbe\u0b95\u0bcd \u0b95\u0bbe\u0bb0\u0bbf\u0baf\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bc1\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba4\u0bb2\u0bbf\u0b9f\u0bae\u0bcd \u0b95\u0bca\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd, \u0b85\u0bb5\u0bb0\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb4\u0bbf\u0b95\u0bb3\u0bc8 \u0ba8\u0bc7\u0bb0\u0bbe\u0b95\u0bcd\u0b95\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd.',theme:'Unwavering Trust',themeTa:'\u0b85\u0b9a\u0bc8\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bbe\u0ba4 \u0ba8\u0bae\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0bc8',category:'Wisdom'},{id:'vod-4',referenceEn:'Malachi 3:10',referenceTa:'\u0bae\u0bb2\u0bcd\u0b95\u0bbf\u0baf\u0bbe 3:10',textEn:'"Bring the whole tithe into the storehouse, that there may be food in my house. Test me in this," says the LORD Almighty, "and see if I will not throw open the floodgates of heaven and pour out so much blessing that there will not be room enough to store it."',textTa:'"\u0b8e\u0ba9\u0bcd \u0b86\u0bb2\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b86\u0b95\u0bbe\u0bb0\u0bae\u0bcd \u0b89\u0ba3\u0bcd\u0b9f\u0bbe\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0b9f\u0bbf, \u0ba4\u0b9a\u0bae\u0baa\u0bbe\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0baf\u0bc6\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd \u0baa\u0ba3\u0bcd\u0b9f\u0b9a\u0bbe\u0bb2\u0bc8\u0baf\u0bbf\u0bb2\u0bc7 \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0bb5\u0bbe\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd; \u0b85\u0baa\u0bcd\u0baa\u0bca\u0bb4\u0bc1\u0ba4\u0bc1 \u0ba8\u0bbe\u0ba9\u0bcd \u0bb5\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bb2\u0b95\u0ba3\u0bbf\u0b95\u0bb3\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4\u0bc1, \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bca\u0bb3\u0bcd\u0bb3\u0bbe\u0bae\u0bb1\u0bcd\u0baa\u0bcb\u0b95\u0bc1\u0bae\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd\u0bae\u0bc7\u0bb2\u0bcd \u0b86\u0b9a\u0bc0\u0bb0\u0bcd\u0bb5\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bc8\u0baa\u0bcd \u0baa\u0bca\u0bb4\u0bbf\u0b95\u0bbf\u0bb1\u0bc7\u0ba9\u0bcb \u0b87\u0bb2\u0bcd\u0bb2\u0bc8\u0baf\u0bcb\u0bb5\u0bc6\u0ba9\u0bcd\u0bb1\u0bc1 \u0b87\u0ba4\u0bbf\u0ba9\u0bbe\u0bb2\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc8\u0b9a\u0bcd \u0b9a\u0bcb\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1\u0baa\u0bcd \u0baa\u0bbe\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b8e\u0ba9\u0bcd\u0bb1\u0bc1 \u0b9a\u0bc7\u0ba9\u0bc8\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0b9a\u0bca\u0bb2\u0bcd\u0bb2\u0bc1\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd."',reflectionEn:'Faithful stewardship is an act of worship and covenant. Honoring God with your firstfruits and tithes unlocks divine protection over your household and opens heaven\u2019s abundance.',reflectionTa:'\u0ba4\u0b9a\u0bae\u0baa\u0bbe\u0b95\u0bae\u0bcd \u0b9a\u0bc6\u0bb2\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0ba4\u0bc1 \u0b95\u0bc0\u0bb4\u0bcd\u0baa\u0bcd\u0baa\u0b9f\u0bbf\u0ba4\u0bb2\u0bbf\u0ba9\u0bcd \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0bae\u0bcd. \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bb0\u0bc1\u0bae\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0ba4\u0bc7\u0bb5\u0ba9\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb0\u0bbf\u0baf\u0ba4\u0bc8 \u0ba8\u0bc7\u0bb0\u0bcd\u0bae\u0bc8\u0baf\u0bcb\u0b9f\u0bc1 \u0b95\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bcb\u0ba4\u0bc1, \u0bb5\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0bb2\u0b95\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bc7\u0bb2\u0bcd \u0ba4\u0bbf\u0bb1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.',theme:'Faithful Stewardship & Blessing',themeTa:'\u0b89\u0ba3\u0bcd\u0bae\u0bc8\u0baf\u0bc1\u0bb3\u0bcd\u0bb3 \u0b95\u0bbe\u0bb0\u0bbf\u0baf\u0bb8\u0bcd\u0ba4\u0bae\u0bc1\u0bae\u0bcd \u0b86\u0b9a\u0bc0\u0bb0\u0bcd\u0bb5\u0bbe\u0ba4\u0bae\u0bc1\u0bae\u0bcd',category:'Provision'},{id:'vod-5',referenceEn:'Isaiah 40:31',referenceTa:'\u0b8f\u0b9a\u0bbe\u0baf\u0bbe 40:31',textEn:'But those who hope in the LORD will renew their strength. They will soar on wings like eagles; they will run and not grow weary, they will walk and not be faint.',textTa:'\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd \u0b95\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcb \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bc6\u0bb2\u0ba9\u0bcd \u0b85\u0b9f\u0bc8\u0ba8\u0bcd\u0ba4\u0bc1, \u0b95\u0bb4\u0bc1\u0b95\u0bc1\u0b95\u0bb3\u0bc8\u0baa\u0bcd\u0baa\u0bcb\u0bb2\u0b9a\u0bcd \u0b9a\u0bc6\u0b9f\u0bcd\u0b9f\u0bc8\u0b95\u0bb3\u0bc8 \u0b85\u0b9f\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1 \u0b8e\u0bb4\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd; \u0b85\u0bb5\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b93\u0b9f\u0bbf\u0ba9\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0b87\u0bb3\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0baf\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd, \u0ba8\u0b9f\u0ba8\u0bcd\u0ba4\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0b9a\u0bcb\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0baa\u0bcb\u0b95\u0bbe\u0bb0\u0bcd\u0b95\u0bb3\u0bcd.',reflectionEn:'Waiting on the Lord is not passive time wasted; it is active strength being infused into your spirit. Rise above your exhaustion in His sovereign presence today.',reflectionTa:'\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb0\u0bc1\u0b9f\u0bc8\u0baf \u0baa\u0bbe\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b95\u0bbe\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bbe \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd. \u0b9a\u0bcb\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc1\u0baa\u0bcb\u0b95\u0bbe\u0bae\u0bb2\u0bcd \u0b95\u0bb4\u0bc1\u0b95\u0bc8\u0baa\u0bcd\u0baa\u0bcb\u0bb2 \u0b89\u0baf\u0bb0 \u0b8e\u0bb4\u0bc1\u0bae\u0bcd\u0baa \u0ba4\u0bc7\u0bb5 \u0baa\u0bc6\u0bb2\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b85\u0bb0\u0bc1\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.',theme:'Supernatural Strength',themeTa:'\u0ba4\u0bc6\u0baf\u0bcd\u0bb5\u0bc0\u0b95 \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bc6\u0bb2\u0ba9\u0bcd',category:'Strength'},{id:'vod-6',referenceEn:'Psalm 23:1-3',referenceTa:'\u0b9a\u0b99\u0bcd\u0b95\u0bc0\u0ba4\u0bae\u0bcd 23:1-3',textEn:'The LORD is my shepherd, I lack nothing. He makes me lie down in green pastures, he leads me beside quiet waters, he refreshes my soul.',textTa:'\u0b95\u0bb0\u0bcd\u0ba4\u0bcd\u0ba4\u0bb0\u0bcd \u0b8e\u0ba9\u0bcd \u0bae\u0bc7\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bb0\u0bbe\u0baf\u0bbf\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd; \u0ba8\u0bbe\u0ba9\u0bcd \u0ba4\u0bbe\u0bb4\u0bcd\u0b9a\u0bcd\u0b9a\u0bbf\u0baf\u0b9f\u0bc8\u0baf\u0bc7\u0ba9\u0bcd. \u0b85\u0bb5\u0bb0\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc8\u0baa\u0bcd \u0baa\u0b9a\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0bb2\u0bcd\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0b87\u0b9f\u0b99\u0bcd\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0baa\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0ba3\u0bcd\u0ba3\u0bbf, \u0b85\u0bae\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4 \u0ba4\u0ba3\u0bcd\u0ba3\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0ba3\u0bcd\u0b9f\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc8\u0b95\u0bcd \u0b95\u0bca\u0ba3\u0bcd\u0b9f\u0bc1\u0baa\u0bcb\u0baf\u0bcd \u0bb5\u0bbf\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd. \u0b85\u0bb5\u0bb0\u0bcd \u0b8e\u0ba9\u0bcd \u0b86\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bbe\u0bb5\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb1\u0bcd\u0bb1\u0bbf, \u0ba4\u0bae\u0bcd\u0bae\u0bc1\u0b9f\u0bc8\u0baf \u0ba8\u0bbe\u0bae\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bbf\u0bae\u0bbf\u0ba4\u0bcd\u0ba4\u0bae\u0bcd \u0b8e\u0ba9\u0bcd\u0ba9\u0bc8 \u0ba8\u0bc0\u0ba4\u0bbf\u0baf\u0bbf\u0ba9\u0bcd \u0baa\u0bbe\u0ba4\u0bc8\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bbf\u0bb1\u0bbe\u0bb0\u0bcd.',reflectionEn:'The Good Shepherd knows your needs before you ask. Rest in His tender care, knowing you lack no good thing as you walk closely with Him today.',reflectionTa:'\u0ba4\u0bc7\u0bb5\u0ba9\u0bc7 \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bb2\u0bcd\u0bb2 \u0bae\u0bc7\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bb0\u0bcd. \u0b85\u0bb5\u0bb0\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0ba4\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bcd \u0baf\u0bbe\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b9a\u0ba8\u0bcd\u0ba4\u0bbf\u0ba4\u0bcd\u0ba4\u0bc1, \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b86\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bbe\u0bb5\u0bc8 \u0b87\u0bb3\u0bc8\u0baa\u0bcd\u0baa\u0bbe\u0bb1\u0bc1\u0ba4\u0bb2\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bbe\u0ba4\u0bbe\u0ba9\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bb3\u0bcd\u0bb3\u0bc1\u0bae\u0bcd \u0ba8\u0b9f\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd.',theme:'The Good Shepherd\u2019s Care',themeTa:'\u0ba8\u0bb2\u0bcd\u0bb2 \u0bae\u0bc7\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bb0\u0bbf\u0ba9\u0bcd \u0baa\u0bb0\u0bbe\u0bae\u0bb0\u0bbf\u0baa\u0bcd\u0baa\u0bc1',category:'Peace'},{id:'vod-7',referenceEn:'Matthew 6:33',referenceTa:'\u0bae\u0ba4\u0bcd\u0ba4\u0bc7\u0baf\u0bc1 6:33',textEn:'But seek first his kingdom and his righteousness, and all these things will be given to you as well.',textTa:'\u0bae\u0bc1\u0ba4\u0bb2\u0bbe\u0bb5\u0ba4\u0bc1 \u0ba4\u0bc7\u0bb5\u0ba9\u0bc1\u0b9f\u0bc8\u0baf \u0bb0\u0bbe\u0b9c\u0bcd\u0baf\u0ba4\u0bcd\u0ba4\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bc1\u0b9f\u0bc8\u0baf \u0ba8\u0bc0\u0ba4\u0bbf\u0baf\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0ba4\u0bc7\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd; \u0b85\u0baa\u0bcd\u0baa\u0bca\u0bb4\u0bc1\u0ba4\u0bc1 \u0b87\u0bb5\u0bc8\u0b95\u0bb3\u0bc6\u0bb2\u0bcd\u0bb2\u0bbe\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0b95\u0bcd \u0b95\u0bca\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd.',reflectionEn:'When God\u2019s Kingdom and righteousness are your highest priority, anxiety melts away because your Heavenly Father guarantees to supply all your earthly needs.',reflectionTa:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bbe\u0bb4\u0bcd\u0b95\u0bcd\u0b95\u0bc8\u0baf\u0bbf\u0bb2\u0bcd \u0ba4\u0bc7\u0bb5\u0ba9\u0bc1\u0b9f\u0bc8\u0baf \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bc1\u0b9f\u0bc8\u0baf \u0bb0\u0bbe\u0b9c\u0bcd\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0ba4\u0bb2\u0bbf\u0b9f\u0bae\u0bcd \u0b95\u0bca\u0b9f\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd. \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b85\u0ba9\u0bcd\u0bb1\u0bbe\u0b9f \u0ba4\u0bc7\u0bb5\u0bc8\u0b95\u0bb3\u0bcd \u0baf\u0bbe\u0bb5\u0bb1\u0bcd\u0bb1\u0bc8\u0baf\u0bc1\u0bae\u0bcd \u0b85\u0bb5\u0bb0\u0bcd \u0baa\u0bca\u0bb1\u0bc1\u0baa\u0bcd\u0baa\u0bc6\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0bca\u0bb3\u0bcd\u0bb5\u0bbe\u0bb0\u0bcd.',theme:'Kingdom Priority',themeTa:'\u0bb0\u0bbe\u0b9c\u0bcd\u0baf\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bae\u0bc1\u0ba4\u0bb2\u0bbf\u0b9f\u0bae\u0bcd',category:'Wisdom'}]},585,[]);
